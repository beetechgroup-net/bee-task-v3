POSTGRES_USER=beetask
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://203.0.113.10:5432/beetask

BACKEND_IMAGE=ghcr.io/owner/repo-backend:latest
FRONTEND_IMAGE=ghcr.io/owner/repo-frontend:latest

QUARKUS_HTTP_CORS_ORIGINS=https://app.example.com
MP_JWT_VERIFY_ISSUER=https://beetech.net
SMALLRYE_JWT_SIGN_KEY_LOCATION=privateKey.pem
