# MinIO (object storage for user avatars)
# MINIO_ROOT_USER and MINIO_ROOT_PASSWORD are used both by the MinIO service
# and by the backend as access/secret keys.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=https://minio.task.beetech.dev
MINIO_BUCKET=avatars
